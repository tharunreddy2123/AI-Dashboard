# OpenShift Configuration (paste your complete token)
VITE_OPENSHIFT_TOKEN=sha256~your_complete_token_here

# Backend API URL
# Local development:
VITE_BACKEND_API_URL=http://localhost:8000
# Production (leave unset on Netlify — the Netlify Function proxy is used automatically)
# VITE_BACKEND_API_URL=https://your-render-backend.onrender.com

# Environment (development / production)
VITE_ENV=development
