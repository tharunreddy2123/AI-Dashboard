# OpenShift Configuration
VITE_OPENSHIFT_API_URL=https://api.rm3.7wse.p1.openshiftapps.com:6443
VITE_OPENSHIFT_TOKEN=your_token_here

# Backend API URL - Change this for production deployment
# For local development: http://localhost:8000
# For production: https://your-backend-domain.com or use relative path
VITE_BACKEND_API_URL=http://localhost:8000

# Custom LLM configuration (optional)
# For production, use a deployed Ollama instance or cloud LLM service
VITE_CUSTOM_LLM_API_URL=http://localhost:11434/v1/chat/completions
VITE_CUSTOM_LLM_API_KEY=ollama
VITE_CUSTOM_LLM_MODEL=openvoid/Void-Gemini

# Environment (development, staging, production)
VITE_ENV=development